// Window and surface management as actions the shell exports (agent.md:
// managing the OS is not a separate API). Types only: for each action, the
// record `<action>-input` (an action with no input takes the empty object and
// has none: WIT has no empty record) and, where it returns something,
// `<action>-output`; the JSON Schemas of the shell's manifest are generated
// from them, with the value encoding of core.wit, as the A2UI catalogue is
// generated from the catalogue. The effect class of each action is stated on
// its first record.
// Versioned on its own.
//
// OPEN (owners): a fresh action instance holds only what its request
// carries (D-035), but these actions act on the compositor's state, which no
// request carries. Proposed: a system service on the trusted list
// (security.md) runs its actions in its own process; the fresh instance
// exists to make a third-party publisher's class binding. Alternative: the
// request of a system service's action carries a capability to that
// service. The same question holds for settings, network, install and
// power.

package os:shell@0.1.0 {
  interface surfaces {
    /// Opaque, 1 to 64 bytes of [a-z0-9-], valid while the surface lives.
    type surface-id = string;
    /// Opaque, 1 to 64 bytes of [a-z0-9-], valid while the display is
    /// connected.
    type display-id = string;

    enum layout { normal, maximized, fullscreen, minimized, left-half, right-half }

    record surface-info {
      id: surface-id,
      /// The owner's component id; "" for the system.
      app: string,
      /// The owner's text, set by `ui.surface.set-title`, at most 256 bytes.
      title: string,
      display: display-id,
      layout: layout,
      focused: bool,
    }

    record display-info {
      id: display-id,
      name: string,
      /// Logical pixels, and the scale to physical pixels (D-060).
      width: u32,
      height: u32,
      scale: f32,
      primary: bool,
    }

    /// list-surfaces. Class none, local. The reply carries `untrusted` and
    /// `private`: titles are written by applications and may show the
    /// user's data. Paged, so that a reply stays under the cap of an action
    /// output: `skip` surfaces first, at most `limit` (<= 64); `more` is true
    /// when surfaces remain.
    record list-surfaces-input { skip: u32, limit: u32 }
    record list-surfaces-output { surfaces: list<surface-info>, more: bool }

    /// list-displays. Class none, local.
    record list-displays-output { displays: list<display-info> }

    /// Class none, local. The actions below of class none change only the
    /// arrangement of the screen, which holds no data and which the user
    /// sees and can redo by hand.
    /// `focus-surface` also decides where the user's next keys go. It
    /// answers `denied` for the agent's bar and for a confirmation, and
    /// `busy` while the user types into another surface (a key in the last
    /// second, starting value to calibrate; keys typed into the agent's bar
    /// do not count, so "focus the terminal" works at once). No key is
    /// dropped after the move. In a task marked `untrusted` it is confirmed
    /// (tasks.invoke). OPEN (owners, security.md point 28): written as
    /// recommended there.
    record focus-surface-input { surface: surface-id }

    /// Class none, local. display: none keeps the current one.
    record arrange-surface-input { surface: surface-id, layout: layout, display: option<display-id> }

    /// Class none, local. Starts the application if it is not running and
    /// gives it a surface (`show`); it runs with its own rights, not the
    /// task's.
    record open-app-input { app: string }
    record open-app-output { surface: surface-id }

    /// Class irreversible, local: the owner receives "dismissed" and may
    /// lose what it had not saved, which the journal cannot restore.
    record close-surface-input { surface: surface-id }
  }
}
