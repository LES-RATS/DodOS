// Storage: objects and collections, no global tree (rule 2).
// Every write is versioned, so nothing in this interface is irreversible and a
// store capability is safe to hand to an action of change `reversible`.
// No purge (drop history, free space at once) is offered to components: it
// would make every store capability irreversible, and with it every action
// that holds one. Purging is an action of the system's storage service, of
// change `irreversible`, so the user confirms it.

interface store {
  use types.{error, rights, provenance, instant};

  /// Stable id (rule 5), given at creation, never reused, unchanged by writes
  /// and across devices. It names an object in logs, journals, memory and
  /// links; it is not a capability and opens nothing.
  /// Form: 128 bits from the system's generator, written as 26 characters of
  /// the base32 alphabet of RFC 4648 in lowercase ("a"-"z", "2"-"7"), no
  /// padding, most significant bits first; the last character carries the
  /// last 3 bits followed by two zero bits. Random rather than time-ordered:
  /// an id travels between devices and into logs, and a time prefix would
  /// tell anyone holding it when the object was made. 128 random bits make a
  /// collision between devices negligible, which the merge by union needs.
  type object-id = string;

  /// Content version. Every `write`, `write-via-stream` and `resize` that
  /// succeeds yields a greater number. Metadata changes do not.
  /// Which past versions stay readable is the system's retention policy
  /// (storage.md), reported by `versions`. The contract guarantees two
  /// things: the current version is always readable, and every version a
  /// journal entry needs to undo stays readable while that entry is
  /// undoable. Every version bound to a journal entry of reach `external`
  /// stays readable as long as the journal keeps the entry, so the user can
  /// see what left.
  type version = u64;

  record object-info {
    id: object-id,
    size: u64,
    /// Media type (RFC 6838), e.g. "text/plain". "" when unknown.
    content-type: string,
    version: version,
    modified: instant,
    /// Rights this handle holds.
    held: rights,
    /// Stamped by the system at each write: who wrote, under which marks.
    /// A read from the user, application, snapshot or device zone also adds
    /// `private`, whoever wrote it (core.wit, `provenance`).
    provenance: provenance,
    /// Free metadata set by `set-meta`. At most 64 pairs.
    meta: list<tuple<string, string>>,
  }

  record version-info { version: version, size: u64, modified: instant }

  resource object {
    info: async func() -> result<object-info, error>;

    /// By value, for small data: at most 65536 bytes per call, else
    /// `too-large`. Anything bigger uses the stream variants (rule 6).
    read: async func(offset: u64, len: u32) -> result<list<u8>, error>;

    /// `expect` makes the write conditional: `conflict` if the object is not
    /// at that version. Returns the new version.
    write: async func(offset: u64, data: list<u8>, expect: option<version>) -> result<version, error>;

    read-via-stream: func(offset: u64) -> tuple<stream<u8>, future<result<_, error>>>;

    /// One new version when the stream ends; none if it fails.
    write-via-stream: async func(offset: u64, data: stream<u8>, expect: option<version>) -> result<version, error>;

    /// Truncates, or extends with zeros.
    resize: async func(size: u64, expect: option<version>) -> result<version, error>;

    set-content-type: async func(content-type: string) -> result<_, error>;

    /// key: 1 to 64 bytes of [a-z0-9-]. value: at most 1024 bytes of UTF-8;
    /// none removes the key.
    set-meta: async func(key: string, value: option<string>) -> result<_, error>;

    /// Durability point: when it returns, every earlier change to this object
    /// survives a power cut. Without it, recent writes may be lost, never torn.
    sync: async func() -> result<_, error>;

    /// Retained versions older than `before`, newest first. limit <= 256.
    versions: async func(before: option<version>, limit: u32) -> result<list<version-info>, error>;

    /// Read-only handle on a retained version. `gone` once it is dropped by
    /// the retention policy.
    at: async func(version: version) -> result<object, error>;

    /// Each new current version, from any writer. Ends when the object is
    /// removed or the handle revoked.
    changes: func() -> stream<version>;

    /// A new handle with a subset of the held rights. Asking for the same
    /// rights duplicates the handle.
    attenuate: func(keep: rights) -> result<object, error>;
  }

  enum entry-kind { object, collection }
  record entry { name: string, kind: entry-kind }

  /// `more` is true when entries remain after the last one returned.
  record page { entries: list<entry>, more: bool }

  /// `present` is false when the entry was removed; true when it was created
  /// or its content changed.
  record entry-change { name: string, present: bool }

  /// The quota is carried by the collection capability and covers everything
  /// under it. Bytes.
  record quota { limit: u64, used: u64 }

  record collection-info {
    held: rights,
    /// none = no limit of its own (the parent's applies).
    quota: option<quota>,
  }

  /// Entry name: 1 to 255 bytes of UTF-8, no "/", no control character,
  /// neither "." nor "..". One level only: walk sub-collections handle by
  /// handle. Compared byte for byte, no normalisation.
  resource collection {
    info: async func() -> result<collection-info, error>;

    open: async func(name: string) -> result<object, error>;
    open-collection: async func(name: string) -> result<collection, error>;

    create: async func(name: string, content-type: string) -> result<object, error>;
    create-collection: async func(name: string) -> result<collection, error>;

    /// Removes the entry; for a collection, all it holds. Reversible through
    /// the system's version history, not through this interface.
    remove: async func(name: string) -> result<_, error>;

    /// Direct entries matching `filter`, in byte order of name, after the
    /// name `after`. limit <= 256. Returns names, not handles: open what you
    /// need. "" lists everything.
    ///
    /// Filter grammar (ABI):
    ///   filter = "" | cmp *( " and " cmp )
    ///   cmp    = field " " op " " value
    ///   field  = "name" | "kind" | "content-type" | "size" | "modified"
    ///          | "meta." key
    ///   op     = "=" | "!=" | "<" | "<=" | ">" | ">=" | "^="
    ///   value  = JSON string | JSON number
    /// "^=" is "starts with", on strings. "kind" is "object" or "collection".
    /// "size" and "modified" compare as numbers, the rest as byte strings.
    /// A cmp on a field the entry lacks is false. Anything else: `invalid`.
    /// No "or": results come in name order, so the caller merges two
    /// queries. Negation is "!=". Full-text and semantic search are not a
    /// store function: they need a derived index (and for semantic search a
    /// model), which is a system indexing service exporting actions.
    query: async func(filter: string, after: option<string>, limit: u32) -> result<page, error>;

    /// Changes to direct entries. Ends when the handle is revoked.
    changes: func() -> stream<entry-change>;

    /// Durability point for create and remove in this collection.
    sync: async func() -> result<_, error>;

    attenuate: func(keep: rights) -> result<collection, error>;
  }

  /// A storage capability of either kind.
  variant item { object(object), collection(collection) }

  /// An item tied to a name: an action argument, a node field, an event
  /// field. The name is what the JSON next to it refers to (see "Value
  /// encoding" in core.wit). Lists of bindings hold at most 64.
  record binding { name: string, item: item }
}

/// Keeping a received capability across launches. Rights from the manifest
/// are re-derived at each launch; a capability received at run time (picker,
/// drop) dies with the instance unless it is put here. An action instance
/// cannot put: it reads `keep` only (core.wit, `world service`), so an
/// action argument dies with the instance.
/// The table belongs to the component identity (rule 3) and is held by the
/// system; revoking a line of it is how the user takes the right back.
/// Not imported by the agent: nothing survives a task.
interface keep {
  use types.{error};
  use store.{item};

  /// slot: 1 to 64 bytes of [a-z0-9-]. Replaces what the slot held. Takes
  /// the handle: `attenuate` first to keep using it. At most 256 slots.
  put: async func(slot: string, item: item) -> result<_, error>;

  /// `revoked` if the user or the giver took it back, `not-found` if empty.
  get: async func(slot: string) -> result<item, error>;

  forget: async func(slot: string) -> result<_, error>;

  slots: async func() -> result<list<string>, error>;
}

/// Giving an object to an application. The shell holds the picker and the
/// clipboard; the application never sees what the user did not choose, and
/// gets a capability attenuated to what was asked. The user's gesture is the
/// grant: there is no permission dialog.
/// Drag and drop is part of the tree: see `drag-source` and `drop-target` in
/// os:catalog-app, and the "dropped" event.
interface exchange {
  use types.{error, rights};
  use store.{item, entry-kind};

  record pick-request {
    /// collection: e.g. a place to save into.
    kind: entry-kind,
    /// Media types to offer; empty = any. May end in "/*".
    content-types: list<string>,
    multiple: bool,
    /// Rights asked on the result. The user sees them.
    want: rights,
  }

  /// Opens the system picker over the caller's surface. `refused` if the
  /// user closes it, `denied` if the caller has no visible surface.
  pick: async func(request: pick-request) -> result<list<item>, error>;

  /// Puts items on the clipboard. Each needs `share`. Answered only right
  /// after a copy or cut gesture of the user on the caller's surface (the
  /// copy key, a menu entry, or a copy button of that surface the user
  /// activated); `denied` otherwise, and always in an action instance,
  /// which has none. The system pins the
  /// current version: later writes do not change what is pasted. The
  /// clipboard keeps each item's provenance, and so does every paste: into
  /// an application (the items' `object-info`), into a catalogue field (the
  /// event's provenance), into the agent's bar (a request part with that
  /// provenance, see `tasks.request`). A paste never turns third-party
  /// content into origin "user".
  copy: async func(items: list<item>) -> result<_, error>;

  /// Read-only items from the clipboard, filtered like `content-types`
  /// above. Answered only right after a paste gesture of the user on the
  /// caller's surface; `denied` otherwise.
  /// Text travels as a "text/plain" object, with no by-value shortcut: one
  /// path (rule 6), and the provenance stays on the object. Text pasted into
  /// a catalogue field or a `text-input` field never reaches the app through
  /// here: the system inserts it.
  paste: async func(content-types: list<string>) -> result<list<item>, error>;
}
