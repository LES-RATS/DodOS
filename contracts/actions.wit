// Actions: what makes a component drivable by the agent. System services
// (settings, windows, network, install, power) export the same interface.
//
// Declaration lives in the signed package manifest, not here: for each
// action, its name, description, input schema, output schema, effect class
// and, for reach `external`, the hosts it may reach. There is deliberately no
// `list-actions` function: a function could change its answer after
// installation, and the component would have to run to be asked. WIT has no
// free annotations, so the manifest is a separate contract, os:manifest
// (manifest.wit); the system reads it and serves it to the agent as
// `action-info` (see `tasks`). This side only executes.
//
// Schemas are JSON Schema 2020-12, in the subset os:manifest fixes, over the
// value encoding of core.wit; a property that is a storage item carries the
// keyword "os-item", a secret one "os-secret" (manifest.wit). A schema
// change is invisible to the WIT breaking-change check, since actions are
// JSON plus a dynamic `invoke`: os:manifest states which schema changes a
// new version may make, and `dodo package` and the installer check them.

interface actions {
  use types.{error};
  use store.{collection, binding};

  record request {
    /// Action name as declared in the manifest: [a-z][a-z0-9-]{0,63}.
    name: string,
    /// JSON object matching the input schema. At most 65536 bytes; larger
    /// data comes as an object. The value of a secret field arrives here,
    /// straight from the system: it never passed through the surface owner.
    input: string,
    /// Storage arguments. A property of `input` that carries "os-item"
    /// holds the name of one of these bindings (core.wit, value encoding); a
    /// binding that no "os-item" property names, or a name that no binding
    /// carries, is `invalid`. Attenuated by the system to the property's
    /// "os-item" rights and to the action's class (read-only when change is
    /// `none`).
    objects: list<binding>,
    /// The component's own collection, attenuated the same way.
    home: collection,
  }

  record outcome {
    /// JSON object matching the output schema. At most 65536 bytes.
    output: string,
    /// Typed object results, each named by an "os-item" property of
    /// `output` (core.wit, value encoding). Each needs `share`. Each must
    /// match the property's `kind` and `content-types`; a binding that no
    /// "os-item" property names, or a name that no binding carries, is
    /// `invalid`, as for `input`.
    objects: list<binding>,
  }

  record progress {
    /// 0.0 to 1.0; none = unknown.
    fraction: option<f32>,
    /// Short text for the user. Third-party text: reading a progress value
    /// adds to the task the marks the instance holds at that point (at least
    /// `untrusted` for a third-party application), as reading the reply
    /// does.
    note: string,
  }

  /// Runs one action in a fresh instance: nothing is shared with the running
  /// application, and the instance is destroyed afterwards. It holds only
  /// what `request` carries, and reads `keep`; its imports are linked to
  /// match the class (see `world service`). This is what makes the declared
  /// class binding.
  ///
  /// `async` because the action keeps running after it returns the stream
  /// and the future: a non-async export may not block, and running on after
  /// returning would need the Component Model's threads, which WASI 0.3.2
  /// does not adopt.
  ///
  /// Progress: write to the stream, any number of times, then resolve the
  /// future. Cancellation: the system drops both reading ends; stop, the
  /// instance is destroyed shortly after.
  ///
  /// An action cannot say whether its output is trusted: the system stamps
  /// the provenance (see `tasks.reply`).
  invoke: async func(request: request) -> tuple<stream<progress>, future<result<outcome, error>>>;
}

/// The agent's side: a task is the unit of delegation. It carries the
/// delegated rights, the marks, the budget and the journal, and is revocable
/// as a whole.
interface tasks {
  use types.{error, effect, marks, provenance, component-id};
  use store.{binding, object-id, version};
  use actions.{progress};
  use accessibility.{accessible};

  /// One piece of the user's request, in the order the user gave them.
  record request-part {
    text: string,
    /// Open set: "typed"; "spoken" (transcribed by the system's recogniser,
    /// and shown in the agent's bar as the system heard it); "pasted";
    /// "dropped" (text dropped on the bar).
    via: string,
    /// Origin "user" for typed and spoken parts. A pasted or dropped part
    /// keeps the provenance of its source, with the marks of the surface it
    /// came from (see `exchange.copy`), so pasting a page into the bar does
    /// not make it the user's words.
    provenance: provenance,
  }

  /// One user request, as `handle` receives it. The task starts with the
  /// union of the marks of `parts`.
  record request {
    /// At most 64 parts and 65536 bytes of text in all.
    parts: list<request-part>,
    /// Objects the user handed over with the request (dropped on the bar,
    /// picked from it). Read-only: the gesture is the grant, as for a
    /// `drop-target`. Handing adds no mark; reading an object adds its marks.
    objects: list<binding>,
    /// The window the user attached to the request (the focused surface,
    /// shown attached in the bar, removable by the user): read-only access
    /// to its accessibility tree. None when nothing is attached.
    screen: option<accessible>,
  }

  /// One action of the task scope, as declared in its package manifest.
  record action-info {
    app: component-id,
    name: string,
    description: string,
    input-schema: string,
    output-schema: string,
    effect: effect,
    /// Who wrote this entry: origin "system" for a system service,
    /// "app:<component-id>", marked `untrusted`, for any other publisher.
    /// Name, description and schemas are the publisher's text, read by the
    /// model.
    provenance: provenance,
  }

  record action-ref { app: component-id, name: string }

  record reply {
    /// Journal entry of this invocation; the handle for `undo`.
    entry: u64,
    output: string,
    objects: list<binding>,
    /// Set by the system. Untrusted for every third-party application.
    /// Reading the reply has already added these marks to the task.
    provenance: provenance,
  }

  /// An object bound to a call, as the journal keeps it: its id and the
  /// version the action received (none for a collection). It opens nothing.
  record bound { name: string, object: option<object-id>, version: option<version> }

  record journal-entry {
    id: u64,
    action: action-ref,
    effect: effect,
    /// The input exactly as invoked, which is exactly what the user
    /// confirmed when a confirmation was drawn: what an external action sent.
    /// Secret properties ("os-secret", manifest.wit) are written as null.
    input: string,
    objects: list<bound>,
    /// What the call created, wrote or removed, as the system saw it in the
    /// instance's own store calls: each object at the version it left, a
    /// removed entry or a collection with version none. A summary for the
    /// user: `undo` restores from the system's own log of the call's store
    /// operations, which is what holds the metadata of a change that left no
    /// version, the object a removed entry had and the collection it belonged
    /// to; `conflict` covers a later change of metadata too.
    writes: list<bound>,
    /// True when the user confirmed this call (or allowed it for the rest
    /// of the task).
    confirmed: bool,
    /// Open set: "running", "held", "done", "failed", "refused",
    /// "cancelled", "undone". "held": confirmed, and the system waits before
    /// calling the action (see `invoke`). Treat an unknown state as not
    /// undoable.
    state: string,
    /// True for a done action of change `reversible` and reach `local` whose
    /// writes the journal holds (`writes`), unless it was decided as an
    /// external modification (see `invoke`), and for a held entry, whose
    /// undo cancels the call.
    undoable: bool,
  }

  /// What the task may still spend. Budgets are split, never copied: a
  /// sub-task's budget is taken from its parent's, and what it did not spend
  /// returns to the parent when it ends. A budget never crosses to another
  /// device.
  record budget {
    /// Processor time, nanoseconds, of the task's threads and of the
    /// services that run on its budget (the budget follows the call, D-039).
    time: u64,
    /// Memory, bytes, drawn on by all the task's processes (D-073).
    memory: u64,
    /// Invocations of actions of reach `external`.
    external: u32,
    /// Tokens sent to or received from a remote model.
    remote-tokens: u64,
  }

  /// A task ends when `handle` returns or the user revokes it; a sub-task
  /// ends when its handle is dropped or its parent ends. Its open streams
  /// and futures then end, and a sub-task's unspent budget returns to the
  /// parent.
  resource task {
    /// The two marks of the task: has read private data, has read untrusted
    /// content. Marks are only ever added. Reading an object handle obtained
    /// through this task adds the object's marks.
    marks: async func() -> result<marks, error>;

    /// The scope: actions this task may invoke, ordered by app then name.
    /// limit <= 64. Reading entries adds their marks, as for any data: a
    /// page holding a third-party entry marks the task `untrusted`.
    /// OPEN (owners, security.md point 5): written as recommended there.
    /// The alternative trusts signed descriptions and adds no mark, which
    /// leaves an injection channel in every manifest. The two owners decide.
    available: async func(skip: u32, limit: u32) -> result<list<action-info>, error>;

    /// The system decides from the action's class and from the marks of the
    /// task and of the items bound to the call (the instance reads them, and
    /// the reply carries their marks back):
    ///
    ///   change        reach     not marked untrusted   marked untrusted
    ///   none          local     runs                   runs
    ///   reversible    local     runs, undoable         runs, undoable
    ///   irreversible  local     confirmation           confirmation
    ///   none          external  runs                   runs unless marked
    ///                                                  private, then
    ///                                                  confirmation
    ///   other         external  confirmation           confirmation
    ///
    /// "Marked" in the table and below is the call's marks: those of its
    /// task and of the items bound to it.
    ///
    /// Three rows change (security.md): an action that receives a secret
    /// ("os-secret", manifest.wit) is confirmed whatever its class, the
    /// secret shown masked (point 18); in a call marked `untrusted`, an
    /// action of change `reversible` or `irreversible` and reach `local` of a
    /// package that can reach the network (the right "network", or hosts on
    /// any of its actions) is decided as an external modification, whatever
    /// it then writes (see `world service`, point 16); in a call marked
    /// `untrusted`, `focus-surface` of os:shell is confirmed (point 28).
    /// An action outside the scope answers `denied`, whatever its class.
    ///
    /// The confirmation is drawn by the system from the action's typed
    /// schema and this exact input, never from text of the agent, and names
    /// the receiving application first. The agent cannot draw, skip or
    /// answer it. A refusal is the error `refused`.
    ///
    /// What the agent may observe of the system's confirmation rules
    /// (security.md): the user may allow an action with this exact input and
    /// the same bound objects (the same object at the same version; a call
    /// that binds a collection, which has no version, is never covered by
    /// the grant and asks when the matrix asks) for the
    /// rest of a task not marked `untrusted`, so a repeat runs without
    /// asking, and a call that binds another item or another version asks
    /// again; the grant ends when the task takes the `untrusted` mark (point
    /// 27); after confirming an external modification the system may
    /// hold the call for a delay, during which the entry is "held" and
    /// `undo` cancels it; while the session is locked, actions on user data
    /// answer `denied`. A task that used a remote model counts as marked
    /// `untrusted` for this table (see `inference`, OPEN there).
    ///
    /// `objects` binds items to the "os-item" properties of `input` by name.
    /// A property that carries "os-secret" is filled only by the system from
    /// a secret field of the overlay; a value for it in `input` is `invalid`.
    /// Progress and cancellation as in `actions.invoke`: drop both reading
    /// ends to cancel. Every progress value, and whatever the action
    /// returns, an outcome or an error (the text of `invalid`, the code of
    /// `other`), carries the reply's marks to the task: an error is
    /// third-party text too. An action of reach `external` beyond the
    /// budget answers `quota-exceeded`.
    invoke: func(action: action-ref, input: string, objects: list<binding>) -> tuple<stream<progress>, future<result<reply, error>>>;

    /// Undoes one entry of this task's journal; `not-found` for any other id
    /// (an entry of a sub-task is undone through the sub-task).
    /// `unsupported` if it is not undoable, `conflict` if a later write or
    /// change of metadata touched the same objects, or a later call created
    /// or removed an entry of the same name in the same collection.
    undo: async func(entry: u64) -> result<_, error>;

    /// Entries of this task's journal, not its sub-tasks', with id greater
    /// than `after`, oldest first. limit <= 256.
    /// Read-only: the journal is written by the system.
    journal: async func(after: option<u64>, limit: u32) -> result<list<journal-entry>, error>;

    /// What remains of the task's budget.
    budget: async func() -> result<budget, error>;

    /// A sub-task whose scope is the given subset of this one (`invalid` if
    /// `actions` names one outside this task's scope), with its own
    /// journal and `share` taken from this task's budget (`quota-exceeded`
    /// if it does not hold that much); revoking the parent revokes it.
    /// Marks: the child starts with the parent's marks, and a mark set in
    /// the child is set in the parent at once. The parent receives what the
    /// child produces, so marks must flow both ways, as they do when a
    /// capability is transferred in the kernel (D-111). A sub-task therefore
    /// cannot quarantine untrusted reading; that needs labels per value,
    /// which D-035 places after version 1.
    subtask: async func(actions: list<action-ref>, share: budget) -> result<task, error>;
  }
}
