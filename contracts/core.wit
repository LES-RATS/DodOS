package os:core@0.1.0;

// The application contract of DodOS. Files of this package:
//   core.wit     shared types, background wake-up, the worlds
//   store.wit    storage, kept handles, object exchange
//   ui.wit       surfaces and the open interface tree
//   input.wit    the text input protocol (application side, engine side)
//   actions.wit  actions (app side), tasks (agent side)
//   agent.wit    inference, memory, audio, the agent's entity, reading
//                another surface's accessibility tree
// Other packages, versioned on their own: catalog.wit (os:catalog-agent,
// os:catalog-app), manifest.wit (os:manifest), shell.wit (os:shell).
// deps/ holds the WASI 0.3.2 packages the worlds import, vendored from the
// WASI release (deps.toml says how; `verify` checks them).
//
// ABI rules (design document):
//   1. Every call on a capability can fail: capabilities are revocable.
//   2. No global name: a name only exists relative to a handle.
//   3. A component's identity is its publisher key plus its name.
//   4. Async is the default.
//   5. Storage objects have stable ids.
//   6. Large data goes through streams or handles, never by value.
//
// Requires WASI 0.3 (async, stream, future): Rust first, other languages when
// their tools get there. There is no WASI 0.2 variant of this package.
// Uses no Component Model feature beyond those WASI 0.3.2 adopts (async,
// stream and future; map; the `implements` and `external-id` annotations).
// Not `error-context`, not threads: both are still gated. `verify` validates
// each world with only the features it uses.
//
// Growth. Adding a case to a variant, enum or flags, or a field to a record,
// breaks the ABI, and the system serves every published version of os:core.
// So whatever is expected to grow is open: `error` has a fallback case; node
// kinds, event kinds, journal states, principals, rights and request
// modalities are strings.
//
// Value encoding (ABI). A typed value carried as a string (action input and
// output, node props, event value, the package manifest) is UTF-8 JSON
// (RFC 8259):
//   bool, string    as in JSON
//   integers, f32/64 JSON number; u64/s64 outside +-2^53 as a decimal string
//   list, tuple     array
//   option          null or the value; an absent key reads as null
//   record          object keyed by the kebab-case field names
//   enum            the case name
//   variant         {"<case>": payload}, or "<case>" when it has no payload
//   flags           array of the set names
//   resource        never encoded: the field holds the `name` of a `binding`
//                   carried next to the string
// Readers ignore object keys they do not know.
//
// Size caps. Each cap is part of the ABI of the version that states it: a
// component may rely on it, a later version of the package may raise it and
// never lowers it. A call over a cap fails with `too-large` or `invalid`,
// and changes nothing. The numbers bound one copy by value (rule 6: one
// Wasm page) or one page of results; nothing measured asks for others.
//   bytes by value in one call (object read, action input and output,
//     node props of one node and of all the nodes of one `update`
//     together, one inference message)                         65536
//   props and bindings a surface's tree holds (bytes)       16777216
//   title of a surface (bytes)                                   256
//   entries in one page (query, versions, journal, memory)       256
//   actions in one page of `available`                            64
//   nodes in one `update`, accessibility nodes in one page       1024
//   bindings in one list                                          64
//   metadata pairs per object; key bytes; value bytes        64; 64; 1024
//   `keep` slots per component                                   256
//   rows of a `table` node                                       200
//   surrounding text in the text input protocol (bytes)          4096
//   text of one memory entry (bytes)                             4096
//   messages in one inference request                            256
//   parts in one agent request                                    64
//   pending wake-ups per component                                64

interface types {
  /// Component identity (rule 3): "<publisher>/<name>".
  /// name is [a-z][a-z0-9-]{0,63}.
  /// publisher is 64 lowercase hexadecimal digits: the TUF key id (SHA-256
  /// of the canonical form of the key, as the TUF specification computes
  /// key ids) of the publisher's first root key. A root rotation signed by
  /// the current root keeps the identity; a new first root is a new
  /// publisher. A hash, so the identity has one length whatever the key
  /// algorithm, and no "/" or ":".
  type component-id = string;

  /// Who produced a piece of data. One of:
  ///   "system"            the system itself
  ///   "user"              typed, spoken or chosen by the user
  ///   "app:<component-id>"
  ///   "web:<origin>"      origin as in RFC 6454, e.g. "web:https://example.org"
  ///   "model:<model-id>"  the output of a model (see `inference.model-info`)
  ///   "capture"           a screenshot or a screen recording; it carries the
  ///                       union of the marks of the surfaces it shows
  ///   "device:<kind>"     a recording made outside a user request; kinds
  ///                       "camera", "microphone"
  ///   "foreign"           media read from the foreign zone (a USB stick,
  ///                       another system's disk)
  /// Open set: treat an unknown prefix as an unknown third party.
  type principal = string;

  /// Milliseconds since the Unix epoch, UTC.
  type instant = u64;

  /// Wide on purpose, so that components match on cases and never parse text.
  variant error {
    /// The capability was revoked. Never retry.
    revoked,
    /// The service or object behind the handle is gone (restart, removal).
    /// Reacquire the handle.
    gone,
    /// The held rights or the action's class do not allow this.
    denied,
    /// The user said no (confirmation, picker, paste). Distinct from `denied`
    /// so that an agent reports it instead of looking for another way.
    refused,
    not-found,
    already-exists,
    /// The entry is an object where a collection was asked, or the reverse.
    wrong-kind,
    /// Conditional write: the object is no longer at the expected version.
    conflict,
    quota-exceeded,
    /// Over a size cap of this contract. Use a stream or a smaller page.
    too-large,
    /// Malformed argument. The text is for a developer; it is not ABI.
    invalid(string),
    /// Known to the contract, not offered here (headless device, unknown
    /// node kind, undo of an irreversible action...).
    unsupported,
    cancelled,
    timeout,
    /// Transient. Retry later.
    busy,
    /// The device failed to read or write.
    io,
    /// Stored data failed its integrity check.
    corrupt,
    /// The network or the remote side is unreachable.
    unreachable,
    /// Fallback. Carries a kebab-case code. A system newer than this version
    /// of the contract reports its newer errors here, with the name of the
    /// newer case as code. Compare codes for equality only; treat an unknown
    /// code as a plain failure.
    other(string),
  }

  /// On an object: read = content and info; write = content and metadata.
  /// On a collection: read = open and query; write = create and remove.
  /// A handle opened from a collection holds at most the collection's rights.
  /// share = the system may hand this capability to another principal
  /// (action argument or result, clipboard, drag). Without it, it stays put.
  flags rights { read, write, share }

  /// Effect class of an action: two independent fields. The class is declared
  /// in the signed manifest, and the system enforces it by what it links to
  /// the action instance (see `world service`). For reach `local` this makes
  /// a false class useless; for reach `external` it only narrows it (see the
  /// OPEN point there).
  enum change { none, reversible, irreversible }
  enum reach { local, external }
  record effect { change: change, reach: reach }

  /// Marks on data, and on a task once it has read such data.
  ///   private    derived from the user's private data
  ///   untrusted  may carry instructions from a third party
  flags marks { private, untrusted }

  /// Set by the system only, never by the producer. `untrusted` is always set
  /// for the origins "app:", "web:", "device:" and "foreign", and for any
  /// origin this version does not know: a publisher cannot declare itself
  /// trusted. For "system", "user", "capture" and "model:" it is set when
  /// third-party content passed through them: text pasted into the agent's
  /// bar, a capture of a third-party surface, a model whose context held
  /// untrusted content (a remote model: see `inference`). Reading the data
  /// adds its marks to the reading task.
  /// `private` comes from where the data lives, not from who wrote it: the
  /// storage service adds it to every read from the user, application,
  /// snapshot and device zones (storage.md), whatever marks the writer had,
  /// so that a file an application saved outside any task still marks its
  /// reader. Cache and ephemeral objects keep their writer's marks; objects
  /// of the system zone and of shared packages carry none; foreign media
  /// carry `untrusted` by their origin. Reading a surface's accessibility
  /// tree adds `private` always (see `accessibility`).
  /// OPEN (owners, security.md point 15): written as recommended there. The
  /// alternatives: marks from the writer only, which leaves the user's own
  /// files unmarked; the application zone marked only when its manifest
  /// asks; downloads excluded from `private`.
  record provenance { origin: principal, marks: marks }
}

/// Being woken without a surface (D-053). Running in the background is the
/// manifest right "background"; without it, `schedule` answers `denied`.
/// The system then starts or resumes an instance, in the background class
/// with its budget, and calls the `wake` export of `world service`.
interface background {
  use types.{error, instant};

  /// kind is an open set: "timer" in this version. tag is the one given to
  /// `schedule`.
  record wake-event { kind: string, tag: string }

  /// Wake this component at `at` (system clock, so a reminder keeps its
  /// wall-clock time across a reboot), never before, at most `slack`
  /// milliseconds after while the machine is awake: the system groups
  /// wake-ups within their slack so that cores sleep. A machine asleep wakes
  /// for it only if the platform can (platform.md). tag: 1 to 64 bytes of
  /// [a-z0-9-]; scheduling a tag again replaces it. A wake-up is delivered
  /// once, then forgotten.
  schedule: async func(tag: string, at: instant, slack: u32) -> result<_, error>;

  /// `not-found` if nothing is pending under that tag.
  cancel: async func(tag: string) -> result<_, error>;
}

/// What every world imports. It is what the Rust standard library of the
/// `wasm32-wasip3` target links into an empty component (checked with Rust
/// 1.100: wasi:cli environment, exit, stdio, terminal; wasi:clocks), plus
/// randomness. None of it is authority. The system links:
///   wasi:cli stdout, stderr  the component's lines in the system log; in the
///                            `wake-word` world, nothing (bytes are dropped)
///   wasi:cli stdin           an empty stream
///   wasi:cli environment     no argument; HOME=/home and TMPDIR=/tmp in the
///                            worlds that have those preopens, nothing else
///   wasi:cli exit            ends the instance
///   wasi:cli terminal-*      none: no component has a terminal
///   wasi:clocks              the monotonic clock and the system clock; the
///                            time zone interface is unstable in WASI 0.3.2
///                            and not offered (zones are a blob, platform.md)
///   wasi:random              the kernel generator (D-057)
/// Versions: imports are matched by semver compatibility, as Wasmtime's
/// component linker does: a component built against wasi:cli@0.3.0 (Rust
/// 1.100's standard library) links to these 0.3.2 interfaces, and the
/// reverse. `wasm-tools component targets` matches names exactly and cannot
/// check this.
world base {
  import wasi:cli/environment@0.3.2;
  import wasi:cli/exit@0.3.2;
  import wasi:cli/types@0.3.2;
  import wasi:cli/stdin@0.3.2;
  import wasi:cli/stdout@0.3.2;
  import wasi:cli/stderr@0.3.2;
  import wasi:cli/terminal-input@0.3.2;
  import wasi:cli/terminal-output@0.3.2;
  import wasi:cli/terminal-stdin@0.3.2;
  import wasi:cli/terminal-stdout@0.3.2;
  import wasi:cli/terminal-stderr@0.3.2;
  import wasi:clocks/types@0.3.2;
  import wasi:clocks/monotonic-clock@0.3.2;
  import wasi:clocks/system-clock@0.3.2;
  import wasi:random/random@0.3.2;
  import wasi:random/insecure@0.3.2;
  import wasi:random/insecure-seed@0.3.2;
}

/// A component without interface: service, server, background work.
/// No function here assumes a screen, a GPU, a keyboard or an agent.
/// A component may import any subset of this world, and nothing else: the
/// installer refuses a component with another import. Granting is the
/// manifest's (os:manifest): an import that is not granted is still linked,
/// and every call on it fails with its interface's own refusal (wasi:sockets
/// `access-denied`, wasi:http `HTTP-request-denied`, wasi:filesystem
/// `access`, os:core `denied`).
///
/// A plain `wasi:http/service` component (a server launched per request,
/// platform.md) or `wasi:cli/command` component (a rescue tool) runs in its
/// own WASI world, with the same linking rules for the network; it exports no
/// action, so the agent cannot drive it.
///
/// The same component is instantiated in two ways.
///
/// Long-lived: `start` or `resume`, later `suspend`; `wake` and `show` on it.
///   - wasi:filesystem preopens: "/home" is `home`, "/tmp" a collection of the
///     ephemeral zone that ends with the instance. These are handles: rule 2
///     holds (paths are relative to them, ".." does not leave them).
///   - wasi:sockets and wasi:http: only with the manifest right "network",
///     to the hosts it lists ("*": any host).
///
/// Once per action: a fresh instance on which the system calls only
/// `actions.invoke`. It shares no memory with the long-lived instance. Its
/// imports are linked to match the action's class (the class is the
/// action's, from the manifest; the component's rights do not widen it):
///   - "/home" is the request's `home`, "/tmp" ends with the instance;
///     "/home" and the bound objects are read-only when change is `none`;
///   - `keep`: `get` and `slots` only; `get` returns the item attenuated to
///     the class (read-only when change is `none`); `put` and `forget`
///     answer `denied`, so nothing the request carried outlives the
///     instance (OPEN, owners, security.md point 17: written as recommended
///     there; the alternative is a `keep` that answers `denied` to every
///     call);
///   - `background` answers `denied`; `exchange.copy` and `exchange.pick`
///     answer `denied` (no gesture, no surface);
///   - reach `local`: every network import fails;
///   - reach `external`: wasi:sockets and name lookup fail; wasi:http
///     `client` reaches only the hosts the manifest lists for that action,
///     written with the grammar of an os:manifest `right` ("https://" and a
///     host, a port if not 443, "https://*.example.org"), over HTTPS (the
///     network service holds TLS, D-055, so it sees the host), and follows
///     no redirect; when change is `none`, only the methods GET and HEAD,
///     with no request body.
/// A package whose manifest holds the right "network" can carry what an
/// action of change `reversible` or `irreversible` wrote into `home` off the
/// machine from its long-lived instance. So in a task marked `untrusted`,
/// such an action of reach `local` is decided by `tasks.invoke` as an
/// external modification: confirmed, held, counted in `budget.external`,
/// not undoable once done. In a task without the mark it stays automatic.
/// An action of change `none` is unaffected: its `home` is read-only.
/// OPEN (owners, security.md point 16): written as recommended there. The
/// alternatives: the same in every task; a read-only or separate `home` for
/// action instances; the network service refusing a marked sender.
/// Known limit, not a hole: an instance of reach `external` reads its own
/// `home` after the matrix decided and may send it to the hosts of its own
/// manifest, which the long-lived instance can do anyway.
/// OPEN (owners, security.md point 1): for reach `external` the class is
/// not binding as it is for `local`. The rule above (GET and HEAD, no body,
/// declared hosts, for change `none`) narrows a false class; it does not
/// stop a server that changes state on GET, data carried in the address of
/// a GET, or a publisher that lists its own host. The alternative is to
/// confirm every action of reach `external`, which confirms every web fetch.
/// The two owners decide; the manifest carries the hosts either way.
world service {
  include base;
  import wasi:filesystem/types@0.3.2;
  import wasi:filesystem/preopens@0.3.2;
  import wasi:sockets/types@0.3.2;
  import wasi:sockets/ip-name-lookup@0.3.2;
  import wasi:http/types@0.3.2;
  import wasi:http/client@0.3.2;

  use store.{collection};
  use background.{wake-event};
  import keep;
  import background;

  export actions;

  /// First launch, or launch with no saved state. `home` is the component's
  /// own collection (zone "application": one user, one component).
  export start: async func(home: collection);

  /// Save state into `home` now. Once it returns, the system may destroy the
  /// instance at any time. This is the only path that crosses devices and
  /// architectures, so save data, not memory.
  export suspend: async func();

  /// Called instead of `start` on a new instance when `suspend` completed
  /// before. Possibly on another device.
  export resume: async func(home: collection);

  /// A wake-up asked through `background`, on the long-lived instance (the
  /// system calls `start` or `resume` first if none runs). A component that
  /// never schedules one implements it as a no-op.
  export wake: async func(event: wake-event);
}

/// A component that draws with the catalogue. Keys and text reach it through
/// the catalogue's kinds and through `text-input` (input.wit).
/// OPEN: the three other ways to draw (design document): the system's
/// interface library (gpui) compiled to Wasm, a web view, raw WebGPU. Raw
/// WebGPU waits for wasi:webgpu, a WASI proposal in phase 2 with no release
/// in WASI 0.3.2; gpui in Wasm draws through the same WebGPU path and also
/// needs its accessibility tree exported; a web view waits for the contract
/// of the web engine's content process (web.md). What decides: a released
/// wasi:webgpu, or the owners choosing to vendor a pre-release, then the
/// compositor's buffer protocol; each path becomes a node kind of
/// os:catalog-app, as `canvas` is.
world app {
  include service;
  use ui.{surface};
  import exchange;
  import text-input;

  // Type-only imports: the catalogue levels this world may emit.
  import os:catalog-agent/kinds@0.1.0;
  import os:catalog-app/kinds@0.1.0;

  /// The shell gives the app a surface. Called after `start` or `resume`,
  /// zero or more times: an app can run with no surface and get one later,
  /// or several. A surface ends when its event stream ends.
  export show: async func(screen: surface);
}

/// The agent. It has no authority of its own: everything it can do comes
/// from `scope` and from what the user handed over in `request`, and nothing
/// survives the task (no `keep`, no filesystem, no network: a remote model
/// is reached by the system, through `inference`).
world agent {
  include base;
  use tasks.{task, request};
  use ui.{surface};

  import os:catalog-agent/kinds@0.1.0;
  import inference;
  import memory;
  import audio;
  import entity;
  import accessibility;

  /// One user request. `overlay` only accepts agent-level kinds. The task
  /// starts with the marks of the request's parts (see `tasks.request`).
  /// The system makes one `handle` call into an instance at a time, so the
  /// entity's hint and an `audio` call belong to the task that runs.
  export handle: async func(request: request, scope: task, overlay: surface);
}

/// The always-on wake-word detector: the microphone as only input, a signal
/// as only output, no network and no storage (agent.md). It imports `base`
/// only so that a standard-library build links; its stdout and stderr go
/// nowhere. What leaks is the timing of detections, to the system only.
world wake-word {
  include base;

  /// `audio`: the microphone, 16 kHz, mono, signed 16-bit samples, after
  /// echo cancellation. Returns one number per detection: the index, counted
  /// from the first sample of `audio`, of the sample where the wake word
  /// ends. Ends when `audio` ends. The system routes the following speech to
  /// the recogniser; the detector never sees what the agent hears.
  export detect: async func(audio: stream<s16>) -> stream<u64>;
}

/// An input engine (input method, virtual keyboard, emoji picker): no
/// network (ui.md). Its storage is the `home` handed to each activation.
world input-engine {
  include base;
  export engine;
}
